{
  "uta-companion": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./runtime/uta-antigravity-hook.mjs --event=SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./runtime/uta-antigravity-hook.mjs --event=PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./runtime/uta-antigravity-hook.mjs --event=PreToolUse",
            "timeout": 65
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./runtime/uta-antigravity-hook.mjs --event=PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./runtime/uta-antigravity-hook.mjs --event=PostInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./runtime/uta-antigravity-hook.mjs --event=Stop",
        "timeout": 10
      }
    ]
  }
}
