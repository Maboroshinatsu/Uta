            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/runtime/uta-host-hook.mjs\" --host=zcode",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/runtime/uta-host-hook.mjs\" --host=zcode",
            "timeout": 5
          }
        ]
      }
