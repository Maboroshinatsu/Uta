{
  "name": "uta-deskpet",
  "version": "0.2.5",
  "description": "Uta desktop pet companion: lifecycle state, completion bubble, desktop approval cards, and character tools.",
  "author": {
    "name": "Maboroshinatsu"
  },
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/runtime/uta-host-hook.mjs\" --host=codex",
              "timeout": 5
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/runtime/uta-host-hook.mjs\" --host=codex",
              "timeout": 5
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/runtime/uta-host-hook.mjs\" --host=codex",
              "timeout": 5
            }
          ]
        }
      ],
      "PermissionRequest": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/runtime/uta-host-hook.mjs\" --host=codex",
              "timeout": 70
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/runtime/uta-host-hook.mjs\" --host=codex",
              "timeout": 5
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/runtime/uta-host-hook.mjs\" --host=codex",
              "timeout": 10
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/runtime/uta-host-hook.mjs\" --host=codex",
              "timeout": 5
            }
          ]
        }
      ],
      "Interrupt": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/runtime/uta-host-hook.mjs\" --host=codex",
              "timeout": 5
            }
          ]
        }
      ]
    }
  },
  "mcpServers": "./.mcp.json",
  "skills": "./skills/"
}
