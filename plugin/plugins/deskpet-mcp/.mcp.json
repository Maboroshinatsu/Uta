{
  "mcpServers": {
    "deskpet": {
      "command": "cmd.exe",
      "cwd": "./",
      "args": [
        "/d",
        "/s",
        "/c",
        "call",
        "./scripts/launch_deskpet_mcp.cmd"
      ],
      "enabled": true,
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 30,
      "env_vars": [
        "APPDATA",
        "USERPROFILE",
        "LOCALAPPDATA",
        "PATH",
        "CODEX_CLI_PATH",
        "CODEX_MCP_NODE_PATH",
        "DESKPET_ENDPOINT_FILE"
      ]
    }
  }
}
